include ../mixins/price-tabs

section.price-tabs
	.price-tabs__container.container
		.price-tabs__nav(role="tablist" aria-label="Категории услуг")
			+priceTab(
				'Консультации',
				'consultations',
				true
				)
			+priceTab(
				'Лечение зависимостей',
				'therapy'
				)
			+priceTab(
				'Дневной стационар',
				'day'
				)
			+priceTab(
				'Диагностика',
				'diagnostics'
				)

		.price-tabs__panel.is-active(id="price-panel-consultations" role="tabpanel" aria-labelledby="price-tab-consultations" data-tab-panel="consultations")
			h2.price-tabs__title.h2 Цены на консультации психиатра, нарколога, психотерапевта
			.price-tabs__list
				+priceRow(
					'Первичная консультация главного врача, врача-психиатра, нарколога, психотерапевта Зубко М.М.',
					'до 60 минут',
					'6 000 ₽'
					)
				+priceRow(
					'Повторная консультация главного врача, врача-психиатра, нарколога, психотерапевта Зубко М.М.',
					'до 30 минут',
					'4 000 ₽'
					)
				+priceRow(
					'Консультация дежурного врача',
					'до 50 минут',
					'4 000 ₽'
					)

		.price-tabs__panel(id="price-panel-therapy" role="tabpanel" aria-labelledby="price-tab-therapy" aria-hidden="true" data-tab-panel="therapy")
			h2.price-tabs__title.h2 Стоимость лечения алкоголизма и вывода из запоя
			.price-tabs__list
				+priceRowTherapy(
					'Снятие алкогольной интоксикации',
					'Инфузионная терапия длительностью 12 часов для стабилизации состояния',
					'9 000 ₽'
					)
				+priceRowTherapy(
					'Прерывание запоя',
					'Комплексное купирование абстиненции в условиях стационара (1 сутки)',
					'13 000 ₽'
					)
				+priceRowTherapy(
					'Курс лечения последствий употребления ПАВ',
					'Базовая программа реабилитации и медикаментозной поддержки (6 суток)',
					'70 000 ₽'
					)
				+priceRowTherapy(
					'Расширенный курс терапии',
					'Углубленная программа восстановления с психотерапией (9 суток)',
					'120 000 ₽'
					)

		.price-tabs__panel(id="price-panel-day" role="tabpanel" aria-labelledby="price-tab-day" aria-hidden="true" data-tab-panel="day")
			h2.price-tabs__title.h2 Стоимость лечения в дневном стационаре
			.price-tabs__list
				.price-tabs__row.price-tabs__row--day
					.price-tabs__name
						span.price-tabs__mark
						span.price-tabs__name-text Лечение душевных расстройств в условиях дневного стационара
					.price-tabs__options
						+priceOption(
							'10 дней',
							'70 000 ₽'
							)
						+priceOption(
							'15 дней',
							'90 000 ₽'
							)
						+priceOption(
							'30 дней',
							'120 000 ₽'
							)
					.price-tabs__order-cell
						button.price-tabs__order(type="button" data-popup="callback") записаться

		.price-tabs__panel(id="price-panel-diagnostics" role="tabpanel" aria-labelledby="price-tab-diagnostics" aria-hidden="true" data-tab-panel="diagnostics")
			h2.price-tabs__title.h2 Цены на консультации психиатра, нарколога, психотерапевта
			.price-tabs__list
				+priceRow(
					'Экспериментально-психологическое исследование',
					'до 240 минут',
					'10 000 ₽'
					)
