			+advantagesItem(
				'Полная анонимность',
				'Мы гарантируем конфиденциальность каждому обратившемуся пациенту'
				)
			+advantagesItem(
				'Индивидуальный подход',
				'Схема терапии определяется только после глубокого изучения анамнеза'
