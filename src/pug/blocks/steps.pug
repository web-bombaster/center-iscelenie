section.steps
	.steps-container.container
		.steps-box
			.steps-top
				h2.h2.steps-title 
					span 5 шагов 
					| к свободной и здоровой жизни
				p.steps-descr Мы понимаем, что обращаться за помощью бывает непросто. Наша задача — сделать этот процесс максимально прозрачным и безопасным
			.steps-slider.swiper
				.steps-slider__wrapper.swiper-wrapper
					.steps-slider__item.steps-item.swiper-slide
						.steps-item__top
							span.steps-item__digit 01
							span.steps-item__name Мотивация и обращение
						span.steps-item__descr Вы оставляете заявку на сайте или звоните нам. Наши специалисты готовы проконсультировать родственников и подсказать, как убедить близкого человека начать лечение
					.steps-slider__item.steps-item.swiper-slide
						.steps-item__top
							span.steps-item__digit 02
							span.steps-item__name Диагностика в центре
						span.steps-item__descr Врач осматривает пациента в клинике, собирает анамнез и оценивает общее физическое и психологическое состояние
					.steps-slider__item.steps-item.swiper-slide
						.steps-item__top
							span.steps-item__digit 03
							span.steps-item__name Детоксикация и купирование острых состояний
						span.steps-item__descr Проведение необходимых медицинских процедур в стационаре (вывод токсинов, капельницы, снятие абстинентного синдрома или панической атаки)
					.steps-slider__item.steps-item.swiper-slide
						.steps-item__top
							span.steps-item__digit 04
							span.steps-item__name Восстановление и терапия
						span.steps-item__descr Индивидуальная схема терапии, включающая в себя медикаментозное лечение и активную психолого-психотерапевтическую помощь для устранения последствий заболевания
					.steps-slider__item.steps-item.swiper-slide
						.steps-item__top
							span.steps-item__digit 05
							span.steps-item__name Ресоциализация и поддержка
						span.steps-item__descr Работа с психологом для возвращения к полноценной жизни и восстановления отношений с близкими людьми (в том числе бесплатные группы поддержки для родственников)
				.steps-slider__nav.slider-nav
					.steps-slider__nav-box.slider-nav__box
						.steps-slider__prev.slider-nav__prev
						.steps-slider__next.slider-nav__next

