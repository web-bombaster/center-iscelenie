- var pageType = 'price';
//- Для pageType указать тип страницы. Варианты:
	home - главная страница
	about - страница о нас

doctype html
html(lang="ru-RU")
	include ../blocks/head
	body#top
		include ../blocks/header
		
		//- home - главная страница
		if pageType === 'home'
			include ../blocks/hero
			include ../blocks/advantages
			.sections-column
				include ../blocks/qa
				include ../blocks/work-areas
				include ../blocks/staff
				include ../blocks/programs
				include ../blocks/steps
				include ../blocks/guarantees
				include ../blocks/page-content
				include ../blocks/reviews
				include ../blocks/faq
				include ../blocks/information

		//- price - страница о нас
		if pageType === 'price'
			include ../blocks/hero-price
			.sections-column
				include ../blocks/makes-cost
				include ../blocks/how-to
				include ../blocks/anonymous
				include ../blocks/faq-price


		//- Общие блоки для всех страниц
		include ../blocks/footer
		include ../blocks/mobile-menu
		include ../blocks/popup-form
		//- include ../blocks/cookie

		//- Подключаем скрипты и стили
		include ../blocks/sourse
